OPENAI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
GRAFANA_PASSWORD=
SUPABASE_JWT_SECRET=<generate: openssl rand -base64 48>

# Cloud deployment only (docker-compose.prod.yaml). Leave blank for local runs.
# The UI is served at DOMAIN itself, with api/auth/airflow/grafana on subdomains
# of it — e.g. DOMAIN=personalinstructor.jesusvega.dev serves the API at
# api.personalinstructor.jesusvega.dev. No scheme, no trailing slash.
# ACME_EMAIL receives Let's Encrypt expiry notices.
DOMAIN=
ACME_EMAIL=

# Per-account cap on questions per calendar month (admins exempt, 0 = no cap).
# Bounds what a shared demo account can spend on LLM calls.
MONTHLY_QUESTION_LIMIT=500
